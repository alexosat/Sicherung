# Vorlage für die Umgebungsvariablen.
# Kopiere diese Datei nach ".env" und trage eigene Werte ein.
# Die Datei ".env" wird NICHT eingecheckt (siehe .gitignore).

# Geheimer Schlüssel für Sitzungen/CSRF – lange, zufällige Zeichenkette.
# Erzeugen z. B. mit:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=bitte-hier-einen-langen-zufaelligen-wert-eintragen

# Passwort für den Admin-Bereich (/admin).
ADMIN_PASSWORD=bitte-sicheres-passwort-setzen

# Name der Schule (erscheint in der Oberfläche).
SCHULNAME=Musterschule

# Optional: abweichender Datenbankpfad (Standard: instance/anmeldungen.db)
# DATABASE_URL=sqlite:///anmeldungen.db
