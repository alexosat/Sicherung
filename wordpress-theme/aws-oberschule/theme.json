{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "1140px", "wideSize": "1280px" },
    "useRootPaddingAwareAlignments": true,
    "color": {
      "defaultPalette": false,
      "custom": true,
      "palette": [
        { "slug": "base", "color": "#F3F6F7", "name": "Hintergrund" },
        { "slug": "surface", "color": "#FFFFFF", "name": "Fläche" },
        { "slug": "surface-2", "color": "#E9EEF1", "name": "Fläche gedämpft" },
        { "slug": "contrast", "color": "#22323A", "name": "Text" },
        { "slug": "muted", "color": "#5A6B73", "name": "Text gedämpft" },
        { "slug": "line", "color": "#DCE5E9", "name": "Linie" },
        { "slug": "primary", "color": "#1B6CA3", "name": "Blau (Primär)" },
        { "slug": "primary-deep", "color": "#145480", "name": "Blau dunkel" },
        { "slug": "primary-soft", "color": "#E1EDF6", "name": "Blau hell" },
        { "slug": "accent", "color": "#3C8C81", "name": "Grün-Teal" }
      ]
    },
    "typography": {
      "fluid": true,
      "customFontSize": true,
      "fontFamilies": [
        {
          "fontFamily": "Figtree, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
          "slug": "figtree",
          "name": "Figtree",
          "fontFace": [
            { "fontFamily": "Figtree", "fontStyle": "normal", "fontWeight": "400", "src": ["file:./assets/fonts/figtree-400-normal-latin.woff2"] },
            { "fontFamily": "Figtree", "fontStyle": "normal", "fontWeight": "500", "src": ["file:./assets/fonts/figtree-500-normal-latin.woff2"] },
            { "fontFamily": "Figtree", "fontStyle": "normal", "fontWeight": "600", "src": ["file:./assets/fonts/figtree-600-normal-latin.woff2"] },
            { "fontFamily": "Figtree", "fontStyle": "normal", "fontWeight": "700", "src": ["file:./assets/fonts/figtree-700-normal-latin.woff2"] }
          ]
        },
        {
          "fontFamily": "Fraunces, Georgia, 'Times New Roman', serif",
          "slug": "fraunces",
          "name": "Fraunces",
          "fontFace": [
            { "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "500", "src": ["file:./assets/fonts/fraunces-500-normal-latin.woff2"] },
            { "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "600", "src": ["file:./assets/fonts/fraunces-600-normal-latin.woff2"] },
            { "fontFamily": "Fraunces", "fontStyle": "italic", "fontWeight": "500", "src": ["file:./assets/fonts/fraunces-500-italic-latin.woff2"] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.9rem", "name": "Klein" },
        { "slug": "medium", "size": "1.05rem", "name": "Normal" },
        { "slug": "large", "size": "1.35rem", "name": "Groß" },
        { "slug": "x-large", "size": "clamp(2rem, 1.6rem + 1.8vw, 3rem)", "name": "Sehr groß" },
        { "slug": "xx-large", "size": "clamp(2.7rem, 2rem + 3.4vw, 4.4rem)", "name": "Hero" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"],
      "spacingSizes": [
        { "slug": "40", "size": "clamp(1.2rem, 1rem + 1vw, 1.6rem)", "name": "S" },
        { "slug": "50", "size": "clamp(2rem, 1.6rem + 2vw, 3rem)", "name": "M" },
        { "slug": "60", "size": "clamp(3.4rem, 2.6rem + 3vw, 5.5rem)", "name": "L" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--figtree)",
      "fontSize": "1.05rem",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--fraunces)", "fontWeight": "600", "lineHeight": "1.1" } },
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Kopfbereich", "area": "header" },
    { "name": "footer", "title": "Fußbereich", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-legal", "title": "Rechtliche Seite", "postTypes": ["page"] }
  ]
}
